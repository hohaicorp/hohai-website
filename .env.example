# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/hohai_db"
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/hohai_shadow"

# Email Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@hohai.com"
ADMIN_EMAIL="admin@hohai.com"

# EmailJS client-side configuration
NEXT_PUBLIC_EMAILJS_SERVICE_ID="service_xuxsnhj"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_CONTACT="your-contact-template-id"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_CONFIRMATION="your-confirmation-template-id"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="your-public-key"

# Optional: Payment Gateway Configuration
RAZORPAY_KEY_ID="your_razorpay_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

STRIPE_PUBLIC_KEY="your_stripe_public_key"
STRIPE_SECRET_KEY="your_stripe_secret_key"

# Optional: JWT Configuration
JWT_SECRET="your_jwt_secret_key_min_32_chars"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Gemini (AI Chatbot)
GOOGLE_API_KEY="your-google-ai-studio-api-key"
GOOGLE_GEMINI_MODEL="gemini-flash-latest"
